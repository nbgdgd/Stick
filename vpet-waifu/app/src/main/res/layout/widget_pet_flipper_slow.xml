<?xml version="1.0" encoding="utf-8"?>
<!--
  The animated character inside the widget.

  A RemoteViews tree cannot run Compose or a frame animation, but ViewFlipper is
  on the short list of view types widgets may contain, and with autoStart it
  cycles its children by itself once the launcher attaches it. Pre-rendered
  frames are added as ImageView children, which makes it a flipbook.

  No in/out animation is set on purpose: the default crossfade would blur one
  pose into the next instead of playing them as frames.

  This is the "slow" tier. The interval lives in XML rather than being set
  through RemoteViews.setInt, because whether ViewFlipper.setFlipInterval is
  a remotable method is not something the SDK stubs can confirm — and an
  unsupported reflective call fails the entire widget update, not just the
  animation.
-->
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pet_flipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateFirstView="false"
    android:autoStart="true"
    android:flipInterval="500"
    android:measureAllChildren="false" />
