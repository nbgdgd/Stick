<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ splits backup from device-to-device transfer. Both carry the same
  thing here: the pet and the settings, never the write-ahead log.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="vpet.db" />
        <include domain="file" path="datastore/" />
        <exclude domain="database" path="vpet.db-wal" />
        <exclude domain="database" path="vpet.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="vpet.db" />
        <include domain="file" path="datastore/" />
        <exclude domain="database" path="vpet.db-wal" />
        <exclude domain="database" path="vpet.db-shm" />
    </device-transfer>
</data-extraction-rules>
