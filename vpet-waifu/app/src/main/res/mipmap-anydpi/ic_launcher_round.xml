<?xml version="1.0" encoding="utf-8"?>
<!-- The foreground is a bitmap rather than a vector, and deliberately so: it
     is the same rendered picture as the store icon and the cover, produced
     from the live character rig by tools/icons/store_icon.py. A hand-drawn
     vector of her was a second drawing of the same girl, and the two had
     already drifted — the phone icon showed one character while the store
     page and the first screen of the app showed another. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
