<?xml version="1.0" encoding="utf-8"?>
<!-- Preview builds get an amber field.

     Overrides the release background rather than the whole icon: she stays
     the same character, and only the field behind her changes. That is enough
     to tell two side-by-side installs apart at a glance, and it costs one
     small file per variant instead of a second set of drawables that would
     drift out of step with the real one. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#3A2A14"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
</vector>
